{
	"name": "dashboard",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "node -v && vite --host 0.0.0.0 --force",
		"build": "tsc && vite build",
		"format": "prettier --check . --config .prettierrc.json --ignore-path .prettierignore",
		"format:fix": "prettier --write . --config .prettierrc.json --ignore-path .prettierignore",
		"lint": "eslint . --max-warnings 0",
		"lint:fix": "eslint . --max-warnings 0 --fix",
		"typecheck": "tsc --noEmit",
		"preview": "vite preview",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest --coverage"
	},
	"dependencies": {
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"@mui/icons-material": "^7.3.9",
		"@mui/material": "^7.3.9",
		"@tanstack/react-query": "^5.96.2",
		"axios": "^1.14.0",
		"lodash": "^4.18.1",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"recharts": "^3.8.1",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.5",
		"@eslint/js": "^10.0.1",
		"@tanstack/eslint-plugin-query": "^5.96.2",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/lodash": "^4.17.24",
		"@types/node": "^25",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.1",
		"@vitest/ui": "^4.1.2",
		"dotenv": "^17.4.0",
		"dotenv-expand": "^12.0.3",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import-x": "^4.16.2",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-prettier": "^5.5.5",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.0.1",
		"eslint-plugin-react-refresh": "^0.5.2",
		"jsdom": "^29.0.1",
		"prettier": "^3.8.1",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.0",
		"validate-env-vars": "^2.0.0",
		"vite": "^8.0.3",
		"vitest": "^4.1.2"
	},
	"packageManager": "pnpm@10.4.1"
}
