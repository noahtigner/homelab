{
	"name": "dashboard",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "node -v && vite --host 0.0.0.0 --force",
		"build": "tsc -p tsconfig.app.json && vite build",
		"format": "prettier --check . --config .prettierrc.json --ignore-path .prettierignore",
		"format:fix": "prettier --write . --config .prettierrc.json --ignore-path .prettierignore",
		"lint": "eslint . --max-warnings 0",
		"lint:fix": "eslint . --max-warnings 0 --fix",
		"typecheck": "tsc --noEmit -p tsconfig.app.json",
		"preview": "vite preview",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest --coverage"
	},
	"dependencies": {
		"@base-ui/react": "^1.4.1",
		"@tailwindcss/vite": "^4.2.4",
		"@tanstack/react-query": "^5.100.1",
		"axios": "^1.15.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lodash": "^4.17.23",
		"lucide-react": "^1.11.0",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"recharts": "^3.7.0",
		"shadcn": "^4.4.0",
		"tailwind-merge": "^3.5.0",
		"tailwindcss": "^4.2.4",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.3",
		"@eslint/js": "^10.0.1",
		"@tanstack/eslint-plugin-query": "^5.100.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/lodash": "^4.17.23",
		"@types/node": "^25",
		"@types/react": "^19.2.9",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.1",
		"@vitest/ui": "^4.1.5",
		"dotenv": "^17.4.2",
		"dotenv-expand": "^13.0.0",
		"eslint": "^10.2.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import-x": "^4.16.1",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-prettier": "^5.5.5",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.2",
		"jsdom": "^29.0.2",
		"prettier": "^3.8.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.0",
		"validate-env-vars": "^2.0.0",
		"vite": "^8.0.10",
		"vitest": "^4.1.5"
	},
	"packageManager": "pnpm@10.4.1"
}
